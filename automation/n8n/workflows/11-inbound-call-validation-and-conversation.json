        "jsCode": "const base = $('Normalize Inbound Request').first().json || {};\nconst preflightRaw = $input.first()?.json || {};\nconst preflight = preflightRaw.data || {};\nconst usage = preflight.usage || {};\nconst includedLimit = Number(usage.includedLimit || 0);\nconst used = Number(usage.used || 0);\nconst usagePercent = Number(usage.usagePercent ?? (includedLimit > 0 ? Math.round((used / includedLimit) * 100) : 0));\nreturn [{ json: {\n  ...base,\n  tenantId: String(preflight.userId || base.tenantId || ''),\n  preflightSuccess: Boolean(preflightRaw.success),\n  accepted: Boolean(preflight.accepted),\n  preflightAction: preflight.action || '',\n  preflightReason: preflight.reason || 'unknown',\n  ownerPhone: preflight.ownerPhone || base.ownerForwardNumber || '',\n  usage,\n  usagePercent,\n  remainingPercent: Math.max(100 - usagePercent, 0),\n  shouldAlert70: usagePercent >= 70\n} }];"
