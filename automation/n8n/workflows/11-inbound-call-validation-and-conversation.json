      "parameters": {
        "jsCode": "const input = $input.first().json || {};\nconst body = input.body || input;\nconst call = body.call || body.call_inbound || {};\nconst args = body.args || {};\nconst payload = body.payload || {};\nconst data = { ...body, ...payload, ...args };\nconst requestedSlot = data.requestedSlot || {};\nconst newSlot = data.newSlot || {};\nconst customer = data.customer || {};\nconst transcript = data.transcript || data.transcript_with_tool_calls?.map((m) => m.content).join(' ') || data.messages?.map((m) => m.content).join(' ') || '';\nconst match = (pattern) => transcript.match(pattern)?.[1]?.trim() || '';\nconst normalizeIntent = (value) => {\n  const intent = String(value || '').toLowerCase().trim();\n  if (['book', 'booking'].includes(intent)) return 'booking';\n  if (['reschedule', 'change'].includes(intent)) return 'reschedule';\n  if (['cancel', 'cancellation'].includes(intent)) return 'cancel';\n  return 'query';\n};\nconst eventType = String(data.event_type || data.event || data.eventType || '').toLowerCase();\nconst callId = data.callId || data.call_id || call.call_id || '';\nreturn [{ json: {\n  callId,\n  eventType,\n  dialedNumber: data.dialedNumber || data.to_number || data.to || call.to_number || '',\n  callerNumber: data.callerNumber || data.from_number || data.from || call.from_number || '',\n  intent: normalizeIntent(data.intent || data.action || body.name),\n  transcript,\n  query: data.query || args.query || transcript,\n  customerName: customer.name || data.customerName || match(/my name is ([a-zA-Z ]+)/i) || 'Unknown Caller',\n  customerEmail: customer.email || data.customerEmail || match(/([a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\\.[a-z]{2,})/i),\n  customerPhone: customer.phone || data.customerPhone || data.callerNumber || data.from_number || call.from_number || '',\n  requestedSlot,\n  requestedDate: requestedSlot.date || data.requestedDate || data.date || '',\n  requestedTime: requestedSlot.time || data.requestedTime || data.time || '',\n  newSlot,\n  newDate: newSlot.date || data.newDate || '',\n  newTime: newSlot.time || data.newTime || '',\n  appointmentId: data.appointmentId || data.appointment_id || '',\n  service: data.service || data.service_type || 'Consultation',\n  idempotencyKey: data.idempotencyKey || body.event_id || (callId ? 'call_' + callId + '_' + (eventType || 'request') : 'request_' + Date.now()),\n  tenantEmail: data.tenantEmail || body.tenant?.email || '',\n  tenantId: data.tenantId || body.tenant?.id || '',\n  tenantTimezone: body.tenant?.timezone || 'UTC',\n  ownerForwardNumber: data.ownerForwardNumber || ''\n} }];"
