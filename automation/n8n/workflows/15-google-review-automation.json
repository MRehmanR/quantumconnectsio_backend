          }
        ],
        [
          {
            "node": "Send Google Review Link",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ask Improvement Feedback": {
      "main": [
        [
          {
            "node": "Log Review Automation Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Google Review Link": {
      "main": [
        [
          {
            "node": "Log Review Automation Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Review Automation Event": {
      "main": [
        [
          {
            "node": "Respond Review Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
